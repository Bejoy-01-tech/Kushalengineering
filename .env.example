# Kushal Engineering – Environment Configuration
# Copy this file to .env and fill in your credentials

# Admin panel password (change this to something secure)
ADMIN_PASSWORD=kushal2026

# Fast2SMS API Key for SMS notifications
# 1. Register FREE at https://www.fast2sms.com
# 2. Go to: API > Dev API Keys > Copy your key
# 3. Paste it below (without quotes)
FAST2SMS_APIKEY=

# Phone number to receive SMS/WhatsApp alerts (with or without +91)
NOTIFY_PHONE=7893663799

# WhatsApp Automated Alerts (CallMeBot Gateway - 100% Free)
# 1. Open WhatsApp and text "I allow callmebot to send me messages" to +34 644 44 20 86
# 2. CallMeBot will reply with your free API key
# 3. Paste your WhatsApp phone and API key below (or set via the website Admin Panel):
WHATSAPP_PHONE=7893663799
WHATSAPP_APIKEY=
# Optional: Custom webhook URL (e.g. Zapier, Make, Green-API, Discord)
WHATSAPP_WEBHOOK_URL=
